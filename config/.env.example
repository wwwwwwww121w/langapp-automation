# API Keys
FIREWORKS_API_KEY=your_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/models/minimax-m2p7

# Reddit
REDDIT_CLIENT_ID=your_id
REDDIT_CLIENT_SECRET=your_secret
REDDIT_USERNAME=your_username
REDDIT_PASSWORD=your_password

# TikTok
TIKTOK_USERNAME=your_username
TIKTOK_PASSWORD=your_password

# Google Cloud (for TTS)
GOOGLE_APPLICATION_CREDENTIALS=path/to/credentials.json

# Paths
CHROME_DRIVER_PATH=chromedriver
FFMPEG_PATH=ffmpeg

# Video Config
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
SECONDS_PER_FRAME=2
FPS=30

# Colors
BG_COLOR_DARK=#0f0f23
BG_COLOR_ACCENT=#1a1a3e
TEXT_COLOR_WHITE=#ffffff
TEXT_COLOR_GOLD=#ffd700
TEXT_COLOR_GREEN=#00e676

# Audio
ENABLE_TTS=true
ENABLE_BACKGROUND_MUSIC=true
VOICE_LANGUAGE=ar-EG
MUSIC_VOLUME=0.3

# Schedule
POST_SCHEDULE_HOUR=18
POST_SCHEDULE_MINUTE=0
COMMENTS_CHECK_INTERVAL_MIN=120
REDDIT_CHECK_INTERVAL_MIN=30
ANALYTICS_DAY=sunday

# App Config
APP_NAME=ArabicEngLearn
APP_LINK=https://play.google.com/store/apps/details?id=com.example.arabicenglearn
APP_STORE_ID=com.example.arabicenglearn
APP_SLOGAN_EN=Learn Arabic & English in one app
APP_SLOGAN_AR=تعلم العربية والإنجليزية في تطبيق واحد
REDDIT_SUBREDDITS=languagelearning,learn_arabic,learnenglish
